unit uiuusuario;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs,
  FMX.Controls.Presentation, FMX.Edit, FMX.Layouts, FMX.StdCtrls;

type
  Tfrmiuusuario = class(TForm)
    Layout1: TLayout;
    Layout2: TLayout;
    Layout3: TLayout;
    Layout4: TLayout;
    Layout5: TLayout;
    edtusunome: TEdit;
    edtusulogin: TEdit;
    edtususenha: TEdit;
    btngravar: TButton;
    Layout6: TLayout;
    Switch1: TSwitch;
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    usuid: integer;
    usulogado: integer;
  end;

var
  frmiuusuario: Tfrmiuusuario;

implementation

{$R *.fmx}

uses umodulo;

procedure Tfrmiuusuario.FormShow(Sender: TObject);
begin
  if (usuid <> 0) then
  begin
    Switch1.IsChecked := usulogado.ToBoolean;
    Switch1.Visible := true;
  end;
end;

end.
